        <script><![CDATA[// On demand. Same behaviour as the legacy "MAINT - Remove accounts with empty names":
// deletes Account records whose name is empty.
var result = new PtagPtaPartnerMap().removeAccountsWithEmptyNames();
var message = 'PTAG Hub - Remove accounts with empty names: deleted ' + result.deleted + ' accounts';
if (result.notDeleted) {
    message += ', could not delete ' + result.notDeleted + ' (the Account table refused the delete)';
    gs.warn(message);
} else {
    gs.info(message);
}]]></script>
