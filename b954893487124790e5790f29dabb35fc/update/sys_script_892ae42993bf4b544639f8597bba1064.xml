        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // Target Geo only takes the regions in x_snc_ptag_engage.target_geo_options. Countries, states and street
    // addresses break the Geo filters and reports. Records that already hold an older value can still be saved
    // as long as Target Geo itself isn't changed.
    if (!current.isNewRecord() && !current.target_geo.changes()) return;
    var geo = new PTAGGeo();
    if (geo.isAllowed(current.getValue('target_geo'))) return;
    gs.addErrorMessage('Target geo must be one of: ' + geo.names().join(', ') + '.');
    current.setAbortAction(true);
})(current, previous);]]></script>
