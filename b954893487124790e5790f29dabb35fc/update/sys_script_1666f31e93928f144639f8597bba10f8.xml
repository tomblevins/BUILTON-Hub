        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
  /* I33: the portal blocks this in the UI, but a UI is not a security boundary.
     Staff are exempt so PTAG can still annotate a closed record. */
  var acc = new x_snc_ptag_engage.PTAGHubAccess();
  /* I34: comments stay open on Unlikely to implement */
  if (!acc.isCommentLocked(current.getValue('state'))) { return; }
  if (acc.isStaff()) { return; }
  if (current.comments.changes()) {
    gs.addErrorMessage('This engagement is closed and can no longer be commented on.');
    current.setAbortAction(true);
  }
})(current, previous);]]></script>
