        <css>.pt-login { position: relative; min-height: 100vh; display: flex; align-items: center; overflow: hidden; }
.pt-login__atmo {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(820px 460px at 18% 30%, rgba(99,223,78,.10), transparent 68%),
    radial-gradient(620px 380px at 82% 12%, rgba(56,189,248,.07), transparent 70%);
}
.pt-login__wrap {
  position: relative; z-index: 1; width: 100%; max-width: 1080px;
  margin: 0 auto; padding: 48px 24px;
  display: grid; grid-template-columns: minmax(0,1.06fr) minmax(0,.94fr); gap: 56px;
  align-items: center;
}
.pt-login__brand { display: flex; align-items: center; gap: 18px; margin-bottom: 26px; }
.pt-login__brand svg, .pt-login__brand img { height: 40px; width: auto; display: block; }
.pt-login__title {
  font-family: var(--pt-font-display); font-size: clamp(30px, 3.6vw, 46px);
  font-weight: 700; letter-spacing: -.022em; line-height: 1.1;
  margin: 0 0 16px; color: var(--pt-text-hi);
}
.pt-login__sub { font-size: 15px; line-height: 1.65; color: var(--pt-text-mute); margin: 0 0 24px; max-width: 52ch; }
.pt-login__points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
.pt-login__points li { display: flex; align-items: flex-start; gap: 10px; font-size: 13.5px; color: var(--pt-text-mute); }
.pt-login__points .pt-i { color: var(--pt-green); flex: none; margin-top: 1px; }
.pt-login__card {
  background: var(--pt-bg-1); border: 1px solid var(--pt-stroke-strong);
  border-radius: 16px; padding: 30px 28px 26px;
  box-shadow: 0 24px 60px rgba(0,0,0,.46);
}
.pt-login__h { margin: 0 0 6px; font-size: 20px; font-weight: 650; color: var(--pt-text-hi); }
.pt-login__note { margin: 0 0 20px; font-size: 13px; color: var(--pt-text-mute); }
.pt-login__foot { margin: 18px 0 0; text-align: center; font-size: 11.5px; color: var(--pt-text-faint); }

/* restyle the OOB login widget's bootstrap controls into the house look */
.pt-login__form .panel, .pt-login__form .panel-body,
.pt-login__form .panel-default { background: transparent !important; border: 0 !important; box-shadow: none !important; padding: 0 !important; margin: 0 !important; }
.pt-login__form .panel-heading, .pt-login__form h1, .pt-login__form h2, .pt-login__form h4 { display: none !important; }
.pt-login__form label { font-size: 12px; font-weight: 600; color: var(--pt-text-mute); margin-bottom: 6px; letter-spacing: .01em; }
.pt-login__form .form-control {
  width: 100%; background: var(--pt-bg-0) !important; color: var(--pt-text-hi) !important;
  border: 1px solid var(--pt-stroke-strong) !important; border-radius: 9px !important;
  height: auto !important; padding: 11px 13px !important; font-size: 14px !important;
  box-shadow: none !important; margin-bottom: 14px;
}
.pt-login__form .form-control:focus { border-color: var(--pt-green) !important; box-shadow: var(--pt-focus-ring) !important; outline: none !important; }
.pt-login__form .btn, .pt-login__form .btn-primary {
  width: 100%; background: var(--pt-green) !important; border: 0 !important;
  color: #06210a !important; font-weight: 700 !important; font-size: 14px !important;
  border-radius: 999px !important; padding: 12px 20px !important;
  transition: filter var(--pt-dur-fast) var(--pt-ease);
}
.pt-login__form .btn:hover { filter: brightness(1.08); }
.pt-login__form a { color: var(--pt-green); font-size: 12.5px; }
.pt-login__form .checkbox, .pt-login__form .form-group { margin-bottom: 10px; }
@media (max-width: 900px) {
  .pt-login__wrap { grid-template-columns: 1fr; gap: 34px; padding: 36px 20px; }
  .pt-login__pitch { text-align: left; }
}

/* ==== I39 (2026-07-28): kill the OOB widget-login's white chrome. The widget
   wraps each field in a white .list-group-item card; flatten those onto our
   dark panel, lift the labels for a dark surface, quiet the reveal-password
   button, and stop Chrome autofill repainting the inputs white. ==== */
.pt-login__form .list-group,
.pt-login__form .list-group-item {
  background: transparent !important; border: 0 !important;
  box-shadow: none !important; padding: 0 !important; margin: 0 !important;
}
.pt-login__form .list-group-item + .list-group-item { margin-top: 14px !important; }
.pt-login__form label, .pt-login__form .label-advanced {
  color: var(--pt-text-mute) !important; font-size: 12px !important;
  font-weight: 600 !important; letter-spacing: .01em; margin-bottom: 6px;
}
.pt-login__form .form-control { margin-bottom: 0 !important; }
.pt-login__form .mask_btn, .pt-login__form .btn-default.icon-preview {
  width: auto !important; background: transparent !important;
  border: 1px solid var(--pt-stroke-strong) !important;
  color: var(--pt-text-mute) !important; border-radius: 9px !important;
  box-shadow: none !important; margin-left: 8px !important; padding: 10px 14px !important;
}
.pt-login__form .mask_btn:hover, .pt-login__form .btn-default.icon-preview:hover {
  color: var(--pt-text-hi) !important; border-color: var(--pt-green) !important;
  background: transparent !important; filter: none;
}
.pt-login__form .form-control::placeholder { color: rgba(148, 163, 184, .5); }
.pt-login__form input:-webkit-autofill,
.pt-login__form input:-webkit-autofill:hover,
.pt-login__form input:-webkit-autofill:focus {
  -webkit-box-shadow: 0 0 0 1000px var(--pt-bg-0) inset !important;
  -webkit-text-fill-color: var(--pt-text-hi) !important;
  caret-color: var(--pt-text-hi);
}
</css>
