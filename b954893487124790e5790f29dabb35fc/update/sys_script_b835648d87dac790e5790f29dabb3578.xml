        <script><![CDATA[(function executeRule(current, previous) {
    /* config change = new model version + one debounced batch rescore.
       The stamp compare in the script action collapses bursts. The event is
       queued ON current (scoped eventQueueScheduled silently drops null-record
       events - I7 ledger evidence). */
    var engine = new x_snc_ptag_engage.PTAGScoringEngine();
    engine.bumpModelVersion();
    var path = engine.scheduleRescoreDebounced(60, current);
    gs.info('[PTAG] weight change -> model v' + engine.modelVersion() + ', rescore via ' + path);
})(current, previous);]]></script>
