        <script><![CDATA[(function executeRule(current, previous) {
    if (String(current.getValue('source_table') || '') !== 'x_snc_ptag_engage_engagement_request') return;
    if (!current.state.changes()) return;
    var st = String(current.state);
    if (st !== 'approved' && st !== 'rejected') return;
    var req = new GlideRecord('x_snc_ptag_engage_engagement_request');
    if (!req.get(String(current.getValue('document_id') || ''))) return;
    var engine = new PTAGApprovalEngine();
    var res = (st === 'approved') ? engine.accept(req, current) : engine.reject(req, current);
    gs.info('[PTAG] approval decision ' + st + ' on ' + req.getValue('number') + ': ' + JSON.stringify(res));
})(current, previous);]]></script>
