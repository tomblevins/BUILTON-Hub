        <condition/>
        <description>Jon 2026-09-29: new requests default to "PTAG Hub - PDS Team" (group looked up by name; created per instance by the PDS team sync job). Skips legacy mirrors.</description>
        <execute_function>false</execute_function>
        <filter_condition table="x_snc_ptag_engage_engagement_request">assignment_groupISEMPTY^legacy_mirror!=true^EQ<item endquery="false" field="assignment_group" goto="false" newquery="false" operator="ISEMPTY" or="false" value=""/>
            <item endquery="false" field="legacy_mirror" goto="false" newquery="false" operator="!=" or="false" value="true"/>
