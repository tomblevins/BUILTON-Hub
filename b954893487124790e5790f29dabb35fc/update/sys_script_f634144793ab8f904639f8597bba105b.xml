        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // New requests default to the PDS team group everybody is part of.
    // Looked up by NAME: the group is created per instance by "PTAG Hub - PDS team membership sync".
    if (current.getValue('assignment_group')) return;
    if (String(current.getValue('legacy_mirror')) === 'true' || String(current.getValue('legacy_mirror')) === '1') return;
    var g = new GlideRecord('sys_user_group');
    g.addQuery('name', 'PTAG Hub - PDS Team');
    g.addActiveQuery();
    g.setLimit(1);
    g.query();
    if (g.next()) current.setValue('assignment_group', g.getUniqueValue());
})(current, previous);]]></script>
