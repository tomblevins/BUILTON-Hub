    </a>
    <div class="pt-nav__links" role="navigation" aria-label="Primary">
      <a href="?id=ptag_home" ng-class="{'is-active': c.page == 'ptag_home' || c.page == ''}">Home</a>
      <a href="?id=ptag_submit" ng-class="{'is-active': c.page == 'ptag_submit'}">Submit</a>
      <a href="?id=ptag_status" ng-class="{'is-active': c.page == 'ptag_status'}">My Engagements</a>
      <a href="?id=ptag_help" ng-class="{'is-active': c.page == 'ptag_help'}">Help</a>
    </div>
    <div class="pt-flex" style="gap: 10px;">
      <!-- B147 #6: light/dark theme. Applies at once, saved to your preferences (ptag.hub.theme). -->
      <button type="button" class="pt-iconbtn pt-themebtn" ng-if="c.user.name" ng-click="c.toggleTheme()"
              aria-pressed="{{c.theme === 'light'}}" aria-label="Light theme"
              title="{{c.themeErr ? 'Theme changed for this visit, but it could not be saved' : (c.theme === 'light' ? 'Switch to the dark theme' : 'Switch to the light theme')}}">
        <svg class="pt-i" aria-hidden="true" ng-if="c.theme !== 'light'"><use href="#ptag-i-sun"/></svg>
        <svg class="pt-i" aria-hidden="true" ng-if="c.theme === 'light'"><use href="#ptag-i-moon"/></svg>
      </button>
      <!-- I21: waiting-on-you signal. Rendered only when something is actually
           outstanding, so the nav stays clean once you are caught up. Goes to
           My Engagements pre-filtered to exactly these records. -->
      <a class="pt-signal" ng-if="c.signal.comments" href="?id=ptag_status&amp;awaiting=1"
         title="{{c.signalTitle}}" aria-label="{{c.signalTitle}}">
        <svg class="pt-i pt-i--sm" aria-hidden="true"><use href="#ptag-i-message-square"/></svg>
        <span class="pt-signal__n">{{c.signal.comments}}</span>
      </a>
      <!-- I22: the profile chip is now a real menu. There was previously no way
           to sign out of the portal at all. -->
      <div class="pt-usermenu" ng-if="c.user.name" ng-class="{'is-open': c.userOpen}">
        <button type="button" class="pt-nav__user pt-usermenu__btn" ng-click="c.toggleUser($event)"
                aria-haspopup="true" aria-expanded="{{c.userOpen}}"
                aria-label="Account menu for {{c.user.name}}" title="{{c.user.name}}">
          <span class="pt-avatar">{{c.initials}}</span>{{c.user.first}}
          <svg class="pt-i pt-usermenu__chev" aria-hidden="true"><use href="#ptag-i-chevron-down"/></svg>
        </button>
        <div class="pt-usermenu__pop" ng-class="{'is-open': c.userOpen}" role="menu"
             ng-click="$event.stopPropagation()">
          <div class="pt-usermenu__head">
            <span class="pt-avatar">{{c.initials}}</span>
            <div>
              <div class="pt-usermenu__full">{{c.user.name}}</div>
              <div class="pt-usermenu__mail" ng-if="c.user.email">{{c.user.email}}</div>
            </div>
          </div>
          <a class="pt-usermenu__item" role="menuitem" href="?id=ptag_status" ng-click="c.closeUser()">
            <svg class="pt-i pt-i--sm" aria-hidden="true"><use href="#ptag-i-list-checks"/></svg> My engagements
          </a>
          <a class="pt-usermenu__item" role="menuitem" href="?id=ptag_submit" ng-click="c.closeUser()">
            <svg class="pt-i pt-i--sm" aria-hidden="true"><use href="#ptag-i-send"/></svg> Submit an engagement
          </a>
          <div class="pt-usermenu__sep"></div>
          <a class="pt-usermenu__item pt-usermenu__item--out" role="menuitem"
             href="/logout.do?sysparm_goto_url=%2Fptag">
            <svg class="pt-i pt-i--sm" aria-hidden="true"><use href="#ptag-i-log-out"/></svg> Sign out
          </a>
        </div>
      </div>
      <a class="pt-btn pt-btn--subtle pt-btn--sm" ng-if="!c.user.name" href="/login.do?sysparm_goto_url=%2Fptag">
        <svg class="pt-i pt-i--sm"><use href="#ptag-i-log-in"/></svg> Sign in
      </a>
    </div>
    <button class="pt-nav__burger" type="button" aria-label="Menu" aria-expanded="{{c.mobileOpen}}"
            aria-controls="pt-mobile-panel" ng-click="c.toggleMobile()">
      <span class="pt-nav__burger-bar"></span><span class="pt-nav__burger-bar"></span><span class="pt-nav__burger-bar"></span>
    </button>
  </div>
  <div class="pt-nav__scrim" ng-class="{'is-open': c.mobileOpen}" ng-click="c.closeMobile()"></div>
  <div class="pt-nav__mobile" id="pt-mobile-panel" role="navigation" aria-label="Primary"
       ng-class="{'is-open': c.mobileOpen}">
    <a href="?id=ptag_home" ng-class="{'is-active': c.page == 'ptag_home' || c.page == ''}" ng-click="c.closeMobile()">Home</a>
    <a href="?id=ptag_submit" ng-class="{'is-active': c.page == 'ptag_submit'}" ng-click="c.closeMobile()">Submit</a>
    <a href="?id=ptag_status" ng-class="{'is-active': c.page == 'ptag_status'}" ng-click="c.closeMobile()">My Engagements</a>
    <a href="?id=ptag_help" ng-class="{'is-active': c.page == 'ptag_help'}" ng-click="c.closeMobile()">Help</a>
    <!-- I32b: a status sentence, not a nav label, so it opts out of the caps treatment -->
    <a class="pt-nav__alert" ng-if="c.signal.comments" href="?id=ptag_status&amp;awaiting=1" ng-click="c.closeMobile()">
      Awaiting your reply <span class="pt-signal__n">{{c.signal.comments}}</span>
    </a>
    <div class="pt-nav__mobile-user" ng-if="c.user.name">
      <span class="pt-avatar">{{c.initials}}</span><span>{{c.user.name}}</span>
    </div>
    <!-- B147 #6 -->
    <button type="button" class="pt-nav__themerow" ng-if="c.user.name" ng-click="c.toggleTheme()" aria-pressed="{{c.theme === 'light'}}">
      <span>Light theme</span>
      <span class="pt-nav__themeval"><svg class="pt-i pt-i--sm" aria-hidden="true" ng-if="c.theme === 'light'"><use href="#ptag-i-moon"/></svg><svg class="pt-i pt-i--sm" aria-hidden="true" ng-if="c.theme !== 'light'"><use href="#ptag-i-sun"/></svg>{{c.theme === 'light' ? 'On' : 'Off'}}</span>
    </button>
    <!-- I22 -->
    <a ng-if="c.user.name" href="/logout.do?sysparm_goto_url=%2Fptag">Sign out</a>
    <a ng-if="!c.user.name" href="/login.do?sysparm_goto_url=%2Fptag">Sign in</a>
  </div>
</nav>]]></template>
