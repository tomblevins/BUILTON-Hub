        <client_script><![CDATA[function($scope, $location) {
  var c = this;

  function currentPage() {
    var q = {};
    try { q = $location.search() || {}; } catch (e) {}
    if (!q.id) {
      try {
        var m = (window.location.search || '').match(/[?&]id=([^&]+)/);
        if (m) { q.id = decodeURIComponent(m[1]); }
      } catch (e2) {}
    }
    return q.id || '';
  }
  c.page = currentPage();

  /* user chip: initials + first name from the server-provided full name */
  var full = '';
  try { full = String((c.data && c.data.user_name) || '').trim(); } catch (e3) {}
  var parts = full ? full.split(/\s+/) : [];
  c.user = { name: full, first: parts[0] || '',
             email: String((c.data && c.data.user_email) || '') };

  /* I22: account menu. Closes on outside click, on Escape, and on navigation. */
  c.userOpen = false;
  c.toggleUser = function (ev) {
    if (ev) { ev.stopPropagation(); }
    c.userOpen = !c.userOpen;
  };
  c.closeUser = function () { c.userOpen = false; };
  function onDocClick() {
    if (!c.userOpen) { return; }
    $scope.$apply(function () { c.userOpen = false; });
  }
  document.addEventListener('click', onDocClick);
  c.initials = ((parts[0] ? parts[0].charAt(0) : '') +
                (parts.length > 1 ? parts[parts.length - 1].charAt(0) : '')).toUpperCase();

  /* I21: waiting-on-you signal, straight from the server payload */
  c.signal = (c.data && c.data.signal) || { comments: 0, records: 0 };
  c.signalTitle = c.signal.comments
    ? (c.signal.comments + ' comment' + (c.signal.comments === 1 ? '' : 's') +
       ' waiting on you across ' + c.signal.records + ' engagement' +
       (c.signal.records === 1 ? '' : 's'))
    : '';


  /* --- B147 #6: light/dark theme -----------------------------------------------
     Applies at once (no reload), then saves to the viewer's preference ptag.hub.theme.
     The same html[data-pt-theme] attribute is what the head boot script and the
     ptag_global link function set, and the per-user cache key is shared with them,
     so all three agree on the next page load (any device: the server value wins). */
  function readTheme() {
    var a = '';
    try { a = document.documentElement.getAttribute('data-pt-theme') || ''; } catch (e) {}
    return a === 'light' ? 'light' : 'dark';
  }
  c.theme = (c.data && (c.data.theme === 'light' || c.data.theme === 'dark')) ? c.data.theme : readTheme();
  c.themeErr = false;
  function applyTheme(t) {
    try { document.documentElement.setAttribute('data-pt-theme', t); } catch (e) {}
    try {
      var uid = (window.NOW && window.NOW.user_id) || '';
      if (uid) { window.localStorage.setItem('ptag.hub.theme.' + uid, t); }
    } catch (e2) {}
  }
  c.toggleTheme = function () {
    var next = c.theme === 'light' ? 'dark' : 'light';
    c.theme = next;
    c.themeErr = false;
    applyTheme(next);
    c.server.get({ action: 'set_theme', theme: next }).then(function (r) {
      var d = (r && r.data) || {};
      if (!d.theme_saved) { c.themeErr = true; }
    }, function () { c.themeErr = true; });
  };

  /* --- I10 mobile nav: toggle + Esc/scrim close + focus management ------- */
  c.mobileOpen = false;
  function q1(sel) { try { return document.querySelector(sel); } catch (e) { return null; } }
  c.openMobile = function () {
    c.mobileOpen = true;
    try { document.body.classList.add('pt-mobilenav-open'); } catch (e) {}
    setTimeout(function () {
      var a = q1('#pt-mobile-panel a'); if (a && a.focus) a.focus();
    }, 280);
  };
  c.closeMobile = function () {
    if (!c.mobileOpen) { return; }
    c.mobileOpen = false;
    try { document.body.classList.remove('pt-mobilenav-open'); } catch (e) {}
    setTimeout(function () {
      var b = q1('.pt-nav__burger'); if (b && b.focus) b.focus();
    }, 0);
  };
  c.toggleMobile = function () { if (c.mobileOpen) { c.closeMobile(); } else { c.openMobile(); } };
  function onKey(ev) {
    var esc = (ev.key === 'Escape' || ev.keyCode === 27);
    if (esc && c.mobileOpen) {
      $scope.$apply(function () { c.closeMobile(); });
    } else if (esc && c.userOpen) {          /* I22 */
      $scope.$apply(function () { c.closeUser(); });
    }
  }
  document.addEventListener('keydown', onKey);
  $scope.$on('$destroy', function () {
    document.removeEventListener('keydown', onKey);
    document.removeEventListener('click', onDocClick);   /* I22 */
    try { document.body.classList.remove('pt-mobilenav-open'); } catch (e) {}
  });
}]]></client_script>
