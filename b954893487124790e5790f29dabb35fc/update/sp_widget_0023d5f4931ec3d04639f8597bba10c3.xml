        <script><![CDATA[(function() {
  /* i3 fix: scoped GlideUser has no getFullName(); use scoped-safe methods. */
  data.is_guest = !gs.getSession().isLoggedIn();
  data.user_name = '';
  if (!data.is_guest) {
    var u = gs.getUser();
    var full = '';
    try { full = String(u.getDisplayName() || ''); } catch (e1) {}
    if (!full) {
      try { full = (String(u.getFirstName() || '') + ' ' + String(u.getLastName() || '')).replace(/^\s+|\s+$/g, ''); } catch (e2) {}
    }
    if (!full) {
      try { full = String(u.getName() || ''); } catch (e3) {}
    }
    data.user_name = full;
    /* I22: the profile menu shows who you are signed in as, so it needs the address */
    try { data.user_email = String(u.getEmail() || ''); } catch (e4) { data.user_email = ''; }
  }

  /* B147 #6: the portal theme. set_theme is the only write in this widget and it only
     ever touches the viewer's OWN preference. Answers early so the toggle never waits
     on the comment signal below. */
  data.theme = 'dark';
  if (!data.is_guest) {
    try { data.theme = String(gs.getUser().getPreference('ptag.hub.theme') || '') === 'light' ? 'light' : 'dark'; } catch (eT0) {}
  }
  if (input && input.action === 'set_theme') {
    data.theme_saved = false;
    if (!data.is_guest) {
      var want = String(input.theme || '') === 'light' ? 'light' : 'dark';
      try { gs.getUser().savePreference('ptag.hub.theme', want); } catch (eT1) {}
      try { data.theme_saved = String(gs.getUser().getPreference('ptag.hub.theme') || '') === want; } catch (eT2) {}
      data.theme = want;
    }
    return;
  }

  /* I21: portal-wide "waiting on you" signal. Same PTAGCommentSignal the My
     Engagements list uses, so the header count and that list can never disagree.
     Wrapped defensively - the nav must never fail over a badge. */
  data.signal = { comments: 0, records: 0 };
  if (!data.is_guest) {
    try {
      var sg = new x_snc_ptag_engage.PTAGCommentSignal().analyzeMine();
      data.signal = { comments: sg.comments, records: sg.records };
    } catch (eSig) {}
  }
})();]]></script>
